generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // For Prisma Client
  directUrl = env("DIRECT_URL") // For Prisma Migrate
}

// --- YOUR CALLLOG MODEL ---
model CallLog {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  fromNumber      String
  toNumber        String
  twilioCallSid   String?  @unique
  strategyUsed    Strategy
  detectionResult CallStatus @default(PENDING)
  detectionLatency Int?
  rawCallback     Json?
}

enum Strategy {
  TWILIO_NATIVE
  JAMBONZ
  HUGGINGFACE
  GEMINI_FLASH
}

enum CallStatus {
  PENDING
  INITIATED
  HUMAN
  MACHINE
  UNKNOWN
  FAILED
}

// --- THE MISSING AUTH MODELS ---

// File: prisma/schema.prisma

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?   // Stored as a hash
  
  name          String?   
  image         String?   
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[] // <-- THIS IS THE FIX. Add this line.
}
model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime

  // --- ADDED FIELDS from the error log ---
  token     String   @unique // This was the "Unknown argument"
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id        String   @id @default(cuid())
  userId    String   
  
  // --- RENAMED FIELDS to match the error log ---
  providerId        String   // Was 'provider'
  accountId         String   // Was 'providerAccountId'
  
  // --- ADDED FIELDS from the error log ---
  password          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // --- UPDATE UNIQUE CONSTRAINT ---
  @@unique([providerId, accountId])
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  
  // --- CORRECTED FIELDS ---
  expiresAt  DateTime // Was 'expires'
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, token])
}